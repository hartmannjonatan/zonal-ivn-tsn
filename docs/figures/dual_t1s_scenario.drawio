"636" as="sourcePoint"/><mxPoint x="1097" y="636" as="targetPoint"/><Array as="points"><mxPoint x="142" y="680"/><mxPoint x="1097" y="680"/></Array></mxGeometry></mxCell><mxCell id="c78" value="" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;strokeColor=#dc2626;dashed=1;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="172" y="636" as="sourcePoint"/><mxPoint x="1177" y="636" as="targetPoint"/><Array as="points"><mxPoint x="172" y="715"/><mxPoint x="1177" y="715"/></Array></mxGeometry></mxCell><mxCell id="c79" value="PT01 TSC1 torque request TCU→ECM + response (10 ms; 1 ms stress)" style="text;html=1;fontSize=10;fontColor=#dc2626;align=left;" vertex="1" parent="1"><mxGeometry x="217" y="648" width="520" height="16" as="geometry"/></mxCell><mxCell id="c80" value="PT02 pedal position read ECM→APP + response (10 ms; 1 ms stress)" style="text;html=1;fontSize=10;fontColor=#dc2626;align=left;" vertex="1" parent="1"><mxGeometry x="217" y="683" width="520" height="16" as="geometry"/></mxCell><mxCell id="c81" value="Cross-bus path: T1S bus A → Z1.ZSW → CSW → Z3.ZSW → T1S bus B&lt;br&gt;+ PT03 EEC1 ECM→TCU, PT04 ETC1 TCU→ECM (10 ms) · all VLAN 40 / PCP 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontSize=10;fontColor=#991b1b;" vertex="1" parent="1"><mxGeometry x="500" y="735" width="460" height="40" as="geometry"/></mxCell><mxCell id="c82" value="&lt;b&gt;Legend &amp; settings&lt;/b&gt;&lt;br&gt;Dark blue = 1 Gb/s backbone · grey = original 100 Mb/s point-to-point catalog links · purple = 10BASE-T1S multidrop (PLCA, max_bc 0, to_timer 32 bit)&lt;br&gt;Yellow = new T1S nodes (all traffic PCP 7 = highest catalog class, shared with brake F08–F10) · red = WINDOW1/3 (catalog flow F15/F17, PCP 3) · dashed red = cross-bus request/response&lt;br&gt;Scheduling: sensor/ECU releases at fixed offsets inside each 1 ms (cross-bus flows first) · clocks drift U(−50, 50) ppm, gPTP Sync 125 ms, Pdelay 1 s · T1S nodes use their zonal switch clock&lt;br&gt;Same-bus loops: ECM↔ETC 1 ms, MAP→ECM 1 ms, LAMBDA→ECM 10 ms, GEAR/OSS→TCU 10 ms · EV variant: bus A = VCU, INVF, DCDC, TMS; bus B = BMS, INVR, OBC, USS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1390" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>